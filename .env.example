# Copy to .env at the repo root and fill in. Only the key is required.
#
# This file is shared by every use case in the repo — one key, one gateway.
# A use case can still keep its own .env in its directory for settings that
# only apply to it; those win over anything set here.

# ---------------------------------------------------------------- shared ----

SYNTHORAI_API_KEY=sk-syn-...

# Any OpenAI-compatible endpoint works here.
#BASE_URL=https://synthorai.io/v1

# ------------------------------------------------- agent-tracing/ only ----

# The model that plans and answers, and the one the sub-agent's checks run on.
#PLANNER_MODEL=gpt-6-luna
#ANALYST_MODEL=deepseek-v4-flash
# Seconds before a model call is given up on.
#REQUEST_TIMEOUT=300

# -------------------------------------------- coding-agent-spend/ only ----

# The model Claude Code runs on, the most one run may cost by Claude Code's
# own count, and the most all runs together may cost before the script
# refuses to start another.
#CODING_MODEL=claude-sonnet-5-5
#RUN_BUDGET_USD=0.60
#SPEND_CEILING_USD=2.00

# ------------------------------------------------- mcp-debugging/ only ----

# A second key, of a different kind: an admin key that can read the request
# log and nothing else (scope logs.read). It cannot call a model, and the key
# above cannot read the log.
#SYNTHORAI_ADMIN_KEY=
# The time range the agent is told to look at. Set it to your own requests.
#LOG_WINDOW=2026-10-08T05:54:00Z to 2026-10-08T06:00:00Z
#AGENT_MODEL=claude-sonnet-5-5
# It reads RUN_BUDGET_USD (0.40 per question when unset) and SPEND_CEILING_USD
# too. Set here, they apply to coding-agent-spend/ as well; to give the two
# different limits, put each project's in its own .env.

# ------------------------------------------------------- chatbot/ only ----

# Built-in web search, toggled per conversation in Settings. Only honoured on
# /v1/messages — naming the tool on /v1/chat/completions returns 200 and
# silently does not search. See synthorai.io/docs/api/web-search/ and
# chatbot/tools.py.
#WEB_SEARCH_ENDPOINT=/messages
#WEB_SEARCH_TOOL=synthorai:web_search
# Rounds per turn, per tool. Both are billed per use and the model chooses how
# many it wants, so these caps are the only brake — one uncapped turn measured
# here ran three searches and two fetches before token costs.
#WEB_SEARCH_MAX_USES=3

# What the model is told about that budget, editable per conversation in
# Settings. Placeholders: {tools} ("3 web searches and 2 page fetches"),
# {searches}, {fetches}. The wording is a real cost lever — see chatbot/README.md.
#TOOL_PROMPT=You may use up to {tools} on this turn. That is a ceiling, not a target.

# Page fetching, also gateway-side and also billed per use. Must be enabled on
# the key: without it the request fails and the client retries without the tool.
#WEB_FETCH_TOOL=synthorai:web_fetch
#WEB_FETCH_MAX_USES=2

# Models that stream their working out as `reasoning_content`, shown in the
# turn's activity trail. Tool turns use the other endpoint, which does not.
#REASONING_MODELS=deepseek-v4-flash,glm-5.2

# Prompt caching. Measured on this gateway, a cached read costs a fraction of
# an uncached one (the ratio differs per model); Gemini accepts the marker and
# ignores it. The write carries a small premium, so the break-even is the
# second request. "1h" survives longer gaps at a higher write premium.
#CACHE_ENABLED=1
#CACHE_TTL=5m

# Shown in the browser tab and the sidebar.
#APP_NAME=Synthorai Chatbot Demo

# UI model lineup, comma-separated; the first is the default. Add any model your
# gateway serves — ids missing from the tier table group under "added by you".
#MODELS=gemini-3.6-flash,deepseek-v4-flash,claude-haiku-4-5,glm-5.2,claude-sonnet-5,claude-opus-5,claude-fable-5

# Working context budget, not a model limit. Compression fires when the next
# turn is projected to exceed it. Lower it per conversation in Settings to watch
# that happen.
#CONTEXT_BUDGET_TOKENS=102400
#KEEP_RECENT_MESSAGES=8
#SUMMARY_MODEL=deepseek-v4-flash
# Output cap for the compression call (summary + extracted facts). Raise it if
# your COMPRESS_PROMPT asks for more than the default's ~200 words — a summary
# truncated mid-sentence is what the next turn inherits.
#COMPRESS_MAX_TOKENS=600
#MAX_COMPLETION_TOKENS=1024

# Conversations, long-term memory, and added models, relative to chatbot/.
#DATA_DIR=.data
